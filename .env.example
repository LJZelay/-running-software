# Example environment variables for external/beta release
# Set these in your deployment environment or .env file

# Always use real NFC hardware (not simulator)
NFC_SIMULATOR=0

# Always enable NFC hardware adapter
FEATURE2_ENABLE_NFC=1

# (Optional) Set the real RFID REST endpoint if not using simulation
# FEATURE2_RFID_REST_URL=http://your-rfid-reader-endpoint:port/

# (Optional) Set log level
# LOG_LEVEL=INFO
